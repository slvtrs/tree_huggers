# If the whole repo was uploaded into a web-accessible folder, forward every
# request into public/ so the site works at /this-folder/ instead of
# /this-folder/public/. app/ and data/ keep their own deny rules.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
